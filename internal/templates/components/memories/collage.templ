package memories

import (
	"fmt"

	"github.com/damongolding/immich-kiosk/internal/common"
)

// Collage renders a memories collage grid with 3–16 photos, caption, and data attributes for lightbox.
// When CollageLayout is set, uses dynamic layout with positioned cells; otherwise falls back to collage-{n} CSS grid.
templ Collage(viewData common.ViewData, secret string) {
	{{ n := len(viewData.Assets) }}
	{{ if n < 1 { n = 1 } }}
	if viewData.CollageLayout != nil {
		<div
			class="collage-grid collage-dynamic"
			data-memories="true"
			data-layout="collage"
			style="position:relative;width:100%;height:100%;"
		>
			for _, cell := range viewData.CollageLayout.Cells {
				{{ asset := viewData.Assets[cell.AssetIndex] }}
				{{ imgURL := "/image/" + asset.Asset.ID }}
				{{ if viewData.Queries != nil && len(viewData.Queries) > 0 { imgURL = imgURL + "?" + viewData.Queries.Encode() } }}
				<div
					class="collage-cell"
					role="button"
					tabindex="0"
					data-asset-id={ asset.Asset.ID }
					style={ fmt.Sprintf("position:absolute;left:%.2f%%;top:%.2f%%;width:%.2f%%;height:%.2f%%;", cell.X*100, cell.Y*100, cell.Width*100, cell.Height*100) }
				>
					<img src={ imgURL } alt="Memory" loading="lazy" style="object-fit:contain;width:100%;height:100%;"/>
				</div>
			}
		</div>
	} else {
		{{ layoutClass := fmt.Sprintf("collage-%d", n) }}
		{{ if viewData.LayoutVariant != "" { layoutClass = fmt.Sprintf("collage-%d-%s", n, viewData.LayoutVariant) } }}
		<div
			class={ "collage-grid", layoutClass }
			data-memories="true"
			data-layout="collage"
		>
			for _, asset := range viewData.Assets {
				{{ imgURL := "/image/" + asset.Asset.ID }}
				{{ if viewData.Queries != nil && len(viewData.Queries) > 0 { imgURL = imgURL + "?" + viewData.Queries.Encode() } }}
				<div
					class="collage-cell"
					role="button"
					tabindex="0"
					data-asset-id={ asset.Asset.ID }
				>
					<img src={ imgURL } alt="Memory" loading="lazy"/>
				</div>
			}
		</div>
	}
	if len(viewData.MemoryCaption) > 0 {
		<div class="collage-caption">
			{ viewData.MemoryCaption }
		</div>
	}
}
